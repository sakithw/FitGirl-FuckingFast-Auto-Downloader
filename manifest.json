{
  "manifest_version": 3,
  "name": "FitGirl-FuckingFast Auto Downloader",
  "version": "1.0.0",
  "description": "Optional single-click assistance for verified FuckingFast file pages.",
  "permissions": ["storage", "downloads", "alarms"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "FitGirl-FuckingFast Auto Downloader",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    },
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://fuckingfast.co/*"],
      "js": ["src/hosts/fuckingfast.js", "src/content/observer.js", "src/content/auto-click.js", "src/content/index.js"],
      "run_at": "document_idle"
    }
  ]
}
