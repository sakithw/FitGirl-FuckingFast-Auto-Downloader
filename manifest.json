{
  "manifest_version": 3,
  "name": "FitGirl-FuckingFast Auto Downloader",
  "version": "0.1.0",
  "description": "Optional single-click assistance for verified FuckingFast file pages.",
  "permissions": ["storage", "downloads"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "FitGirl-FuckingFast Auto Downloader",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://fuckingfast.co/*"],
      "js": ["src/hosts/fuckingfast.js", "src/content/observer.js", "src/content/auto-click.js", "src/content/index.js"],
      "run_at": "document_idle"
    }
  ]
}
